# Copiar a .env.local. Sin DATABASE_URL la app usa PGlite en ./data (base local embebida).
# DATABASE_URL=postgres://...            # Neon (rama de pruebas para local)
# BETTER_AUTH_SECRET=                     # obligatorio en producción
# BETTER_AUTH_URL=https://...             # URL pública en producción
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=   # habilita "Continuar con Google"
# RESEND_API_KEY= / MAIL_FROM="Estudio <no-reply@tudominio>"  # links mágicos, invitaciones y reset; sin clave se imprimen en la consola

# Cuenta de prueba local (solo PGlite): prueba@estudio.test / Prueba-Local-2026
# CRON_SECRET=                          # protege /api/cron/recordatorios (Vercel lo manda solo)
# COURT_VAULT_KEY=                       # 32 bytes en base64 (openssl rand -base64 32): cifra las claves de tribunales. App y worker usan la misma.
# BLOB_READ_WRITE_TOKEN=                 # Vercel Blob (documentos y archivos de tribunales)
# ANTHROPIC_API_KEY=                     # IA (Mike y agente de vencimientos)
# AI_USD_ARS=1500                        # cotización para convertir el costo de la IA a pesos
# AI_MARKUP=1                            # margen sobre el costo (1 = al costo)
# PLATFORM_ADMINS=vos@tudominio.com      # quienes pueden cargar créditos de IA a los estudios
# NEXT_PUBLIC_DROPBOX_APP_KEY=           # habilita "Elegir en Dropbox" (Dropbox Chooser); sin clave se vinculan pegando el link
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (arriba) también habilitan Google Calendar. Redirect URI a registrar en Google:
#   <BETTER_AUTH_URL>/api/integraciones/google/callback   (y la API "Google Calendar" habilitada en el proyecto)

# Google Drive como almacenamiento (ver docs/DRIVE.md). Usa el mismo GOOGLE_CLIENT_ID/SECRET de arriba.
# Opcional: JSON de la cuenta de servicio, en una sola línea. Con él se ven también los archivos que el estudio mueva a mano a su carpeta.
GOOGLE_SERVICE_ACCOUNT_JSON=
